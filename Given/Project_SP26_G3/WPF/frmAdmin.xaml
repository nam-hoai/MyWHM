<Window x:Class="WPF.frmAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="AdminDashBoard" Height="650" Width="800">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <TabControl  Background="LightBlue" Margin="10" Grid.Row="0">
            <TabItem Header="Account Management"
                     DataContext="{Binding AccountVM}">
                <StackPanel>
                    <DataGrid  ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                               AutoGenerateColumns="False" Margin="10" Width="700">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Active -->
                                    <DataTrigger Binding="{Binding Status}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                    <!-- Deactive -->
                                    <DataTrigger Binding="{Binding Status}" Value="False">
                                        <Setter Property="Background" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding PersonId}" Width="*"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding PersonName}" Width="*"/>
                            <DataGridTextColumn Header="Password" Binding="{Binding Password}"/>
                            <DataGridTextColumn Header="Date Of Birth" Binding="{Binding Birthdate}" Width="*"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Header="Detail Info" Width="700" Margin="10" Background="LightGray">
                        <WrapPanel Margin="5">
                            <StackPanel Margin="5" Width="500">
                                <WrapPanel>
                                    <Label Content="Person ID" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormAccount.PersonId, Mode=TwoWay}"
                                             Width="350" Margin="5"
                                             IsReadOnly="True"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Person Name" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormAccount.PersonName, Mode=TwoWay}" 
                                             Width="350" Margin="5"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Password" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormAccount.Password, Mode=TwoWay}" 
                                             Width="350" Margin="5"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Date Of Birth" Width="100" Margin="5" FontWeight="Bold"/>
                                    <DatePicker SelectedDate="{Binding FormAccount.Birthdate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                                SelectedDateFormat="Short"
                                                Width="350" Margin="5"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Address" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormAccount.Address, Mode=TwoWay}" 
                                             Width="350" Margin="5"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Phone" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormAccount.Phone, Mode=TwoWay}" 
                                             Width="350" Margin="5"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Status" Width="100" Margin="5" FontWeight="Bold"/>
                                    <RadioButton Content="Active"
                                                 GroupName="StatusFilter"
                                                 IsChecked="{Binding FormAccount.Status,
                                                             Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"/>

                                    <RadioButton Content="Deactive"
                                                 GroupName="StatusFilter"
                                                 IsChecked="{Binding FormAccount.Status,
                                                             Mode=TwoWay,
                                                             Converter={StaticResource InverseBoolConverter},
                                                             UpdateSourceTrigger=PropertyChanged}"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel>
                                <Button Width="100" Margin="5" Content="ADD" Command="{Binding AddCommand}"/>
                                <Button Width="100" Margin="5" Content="EDIT" Command="{Binding EditCommand}"/>
                                <Button Width="100" Margin="5" Content="DELETE" Command="{Binding DeleteCommand}"/>
                                <Button Width="100" Margin="5" Content="SEARCH" Command="{Binding SearchCommand}"/>
                                <Button Width="100" Margin="5" Content="RESET" Command="{Binding ResetCommand}"/>
                                <Button Width="100" Margin="5" Content="BACKLOG DATA" Command="{Binding BacklogCommand}"/>
                                <Button Width="100" Margin="5" Content="GENERATE DATA" Command="{Binding ReportCommand}"/>
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Wasehose Configuration"
                     DataContext="{Binding WarehouseVM}">
                <StackPanel>
                    <DataGrid Margin="10" Width="700" AutoGenerateColumns="False"
                              ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding WarehouseId}" Width="*"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding WarehouseName}" Width="5*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="2*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Active -->
                                    <DataTrigger Binding="{Binding Status}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                    <!-- Deactive -->
                                    <DataTrigger Binding="{Binding Status}" Value="False">
                                        <Setter Property="Background" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <GroupBox Header="Detail Info" Width="700" Margin="10" Background="LightGray">
                        <WrapPanel Margin="5">
                            <StackPanel Margin="5" Width="500">
                                <WrapPanel>
                                    <Label Content="Wasehouse ID" Width="120" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5"
                                             Text="{Binding FormWarehouse.WarehouseId, Mode=TwoWay}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Wasehouse Name" Width="120" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5"
                                             Text="{Binding FormWarehouse.WarehouseName, Mode=TwoWay}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Size" Width="120" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5"
                                             Text="{Binding FormWarehouse.Size, Mode=TwoWay}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Status" Width="120" Margin="5" FontWeight="Bold"/>
                                    <RadioButton Content="Enable"
                                         GroupName="StatusFilter"
                                         IsChecked="{Binding FormWarehouse.Status,
                                                     Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"/>

                                    <RadioButton Content="Disable"
                                         GroupName="StatusFilter"
                                         IsChecked="{Binding FormWarehouse.Status,
                                                     Mode=TwoWay,
                                                     Converter={StaticResource InverseBoolConverter},
                                                     UpdateSourceTrigger=PropertyChanged}"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel>
                                <Button Width="100" Margin="5" Content="ADD" Command="{Binding AddCommand}"/>
                                <Button Width="100" Margin="5" Content="EDIT" Command="{Binding EditCommand}"/>
                                <Button Width="100" Margin="5" Content="DELETE" Command="{Binding DeleteCommand}"/>
                                <Button Width="100" Margin="5" Content="SEARCH" Command="{Binding SearchCommand}"/>
                                <Button Width="100" Margin="5" Content="RESET" Command="{Binding ResetCommand}"/>
                                <Button Width="100" Margin="5" Content="BACKLOG DATA" Command="{Binding BacklogCommand}"/>
                                <Button Width="100" Margin="5" Content="GENERATE DATA" Command="{Binding ReportCommand}"/>
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Product Catalog"
                     DataContext="{Binding ProductVM}">
                <StackPanel>
                    <DataGrid Margin="10" Width="700" AutoGenerateColumns="False"
                              ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductId}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding ProductName}"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Sender" Binding="{Binding Sender}"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}"/>
                            <DataGridTextColumn Header="Category Name" Binding="{Binding Cat.CatName}"/>
                            <DataGridTextColumn Header="Dat Stock In" Binding="{Binding DateIn}"/>
                            <DataGridTextColumn Header="Date Stock Out" Binding="{Binding DateOut}"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Active -->
                                    <DataTrigger Binding="{Binding Status}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                    <!-- Deactive -->
                                    <DataTrigger Binding="{Binding Status}" Value="False">
                                        <Setter Property="Background" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <GroupBox Header="Detail Info" Width="700" Margin="10" Background="LightGray">
                        <WrapPanel Margin="5">
                            <StackPanel Margin="5" Width="500">
                                <WrapPanel>
                                    <Label Content="Product ID" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5" 
                                             Text="{Binding FormProduct.ProductId, Mode=TwoWay}"
                                             IsReadOnly="true"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Product Name" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5"
                                             Text="{Binding FormProduct.ProductName, Mode=TwoWay}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Product Code" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5"
                                             Text="{Binding FormProduct.ProductCode, Mode=TwoWay}"
                                             IsReadOnly="true"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Quantity" Width="100" Margin="5" FontWeight="Bold"/>
                                    <TextBox Width="350" Margin="5"
                                             Text="{Binding FormProduct.Quantity, Mode=TwoWay}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Sender" Width="100" Margin="5" FontWeight="Bold"/>
                                    <ComboBox Width="350" Margin="5"
                                             ItemsSource="{Binding Persons}"
                                             DisplayMemberPath="PersonName"
                                             SelectedValuePath="PersonName"
                                             SelectedValue="{Binding FormProduct.Sender}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Location" Width="100" Margin="5" FontWeight="Bold"/>
                                    <ComboBox Width="350" Margin="5"
                                             ItemsSource="{Binding Locations}"
                                             DisplayMemberPath="WarehouseName"
                                             SelectedValuePath="WarehouseName"
                                             SelectedValue="{Binding FormProduct.Location}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Category Name" Width="100" Margin="5" FontWeight="Bold"/>
                                    <ComboBox Width="350" Margin="5"
                                              ItemsSource="{Binding Categories}"
                                              DisplayMemberPath="CatName"
                                              SelectedValuePath="CatId"
                                              SelectedValue="{Binding FormProduct.CatId}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Date Stock In" Width="100" Margin="5" FontWeight="Bold"/>
                                    <DatePicker Width="350" Margin="5"
                                                SelectedDate="{Binding FormProduct.DateIn, Mode=TwoWay}"
                                                DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                                SelectedDateFormat="Short"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Date Stock Out" Width="100" Margin="5" FontWeight="Bold"/>
                                    <DatePicker Width="350" Margin="5"
                                                SelectedDate="{Binding FormProduct.DateOut, Mode=TwoWay}"
                                                DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                                SelectedDateFormat="Short"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="Status" Width="100" Margin="5" FontWeight="Bold"/>
                                    <WrapPanel Width="350" Margin="5" VerticalAlignment="Center">
                                        <RadioButton    Content="Enable"
                                                        GroupName="StatusFilter"
                                                        IsChecked="{Binding FormProduct.Status,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                        <RadioButton Content="Disable"
                                                        GroupName="StatusFilter"
                                                        IsChecked="{Binding FormProduct.Status,
                                                                    Mode=TwoWay,
                                                                    Converter={StaticResource InverseBoolConverter},
                                                                    UpdateSourceTrigger=PropertyChanged}"/>
                                    </WrapPanel>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel>
                                <Button Width="100" Margin="5" Content="ADD" Command="{Binding AddCommand}"/>
                                <Button Width="100" Margin="5" Content="EDIT" Command="{Binding EditCommand}"/>
                                <Button Width="100" Margin="5" Content="DELETE" Command="{Binding DeleteCommand}"/>
                                <Button Width="100" Margin="5" Content="SEARCH" Command="{Binding SearchCommand}"/>
                                <Button Width="100" Margin="5" Content="RESET" Command="{Binding ResetCommand}"/>
                                <Button Width="100" Margin="5" Content="BACKLOG DATA" Command="{Binding BacklogCommand}"/>
                                <Button Width="100" Margin="5" Content="GENERATE DATA" Command="{Binding ReportCommand}"/>
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Reporting Generation"
                     DataContext="{Binding ReportVM}">
                <StackPanel>
                    <GroupBox Header="File Control" Width="700" Margin="10" Background="LightGray">
                        <StackPanel>
                            <WrapPanel Margin="5">
                                <Label Content="File Name: " Margin="5" Width="100" FontWeight="Medium" FontSize="14"/>
                                <TextBox x:Name="txtName3" Margin="5" Width="350"/>
                                <Button Content="SEARCH" Margin="5" Width="150" Command="{Binding SearchCommand}"/>
                            </WrapPanel>
                            <DataGrid Width="650" Margin="10" AutoGenerateColumns="False"
                                      ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Width="*" Binding="{Binding FileName}"/>
                                    <DataGridTextColumn Header="Path" Width="*" Binding="{Binding FilePath}"/>
                                    <DataGridTextColumn Header="CreatedAt" Width="*" Binding="{Binding CreatedAt}"/>
                                    <DataGridTextColumn Header="Size" Width="*" Binding="{Binding FileSize}"/>
                                    <DataGridTemplateColumn Header="Actions" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <WrapPanel>
                                                    <Button Content="Export" Command="{Binding ExportCommand}"/>
                                                    <Button Content="Delete" Command="{Binding DeleteCommand}"/>
                                                </WrapPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="BACKLOG DATA" Width="100" HorizontalAlignment="Right" Margin="5"
                                    Command="{Binding BacklogCommand}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Content" Width="700" Margin="10" Background="LightGray">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Margin="5" Width="600" Height="200" TextWrapping="Wrap"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Row="0" IsReadOnly="true"
                                     Text="{Binding FormReport.Content, Mode=TwoWay}"/>
                            <Button Grid.Row="1" Content="CLEAR UP" Width="100" HorizontalAlignment="Right"
                                    Command="{Binding ResetCommand}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
        <WrapPanel Grid.Row="1">
            <Button Width="100" Margin="10" Content="Exit"  
                    Command="{Binding OutCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </WrapPanel>
    </Grid> 
</Window>
